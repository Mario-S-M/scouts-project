DB_HOST=localhost
DB_PORT=5432
DB_NAME=scouts_cc
DB_USER=scouts_user
DB_PASSWORD=scouts_pass
PORT=3000
NODE_ENV=development
UPLOAD_DIR=./uploads

# Número de proxies propios delante del backend. Define la IP que usa el límite de
# intentos del login. En el Pi se midió: internet → cloudflared → nginx → backend
# (2 saltos) y red local → nginx → backend (1 salto). Con 2, desde la red local se
# podría falsificar la IP con X-Forwarded-For, así que se usa 1: los accesos por
# internet comparten IP en el contador y la clave IP + correo evita que una cuenta
# bloquee a otra.
TRUST_PROXY_HOPS=1

# Recordatorios de calendario por Telegram
# 1. Crea un bot con @BotFather en Telegram (comando /newbot) y copia el token que te da.
# 2. @BotFather también te da el username del bot (sin la @), úsalo en TELEGRAM_BOT_USERNAME.
# 3. Crea un grupo de Telegram para la comunidad, agrega el bot como miembro,
#    y obtén el chat_id del grupo (por ejemplo, agregando temporalmente @RawDataBot al grupo).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_GROUP_CHAT_ID=
